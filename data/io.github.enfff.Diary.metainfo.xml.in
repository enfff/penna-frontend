<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.enfff.Diary</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Diary</name>
  <summary>A calm place for daily notes</summary>
  <description>
    <p>
      Diary is a local-first journaling app. Every entry is a plain Markdown
      file stored in a git repository you own — no accounts, no cloud
      service, no lock-in.
    </p>
    <p>Highlights:</p>
    <ul>
      <li>Distraction-free editor with optional viewer mode</li>
      <li>One note per day, found fast in a searchable grid</li>
      <li>Markdown formatting with syntax highlighting</li>
      <li>History and multi-machine sync through plain git</li>
      <li>Conflict-safe syncing with a guided resolver</li>
    </ul>
  </description>

  <developer id="io.github.enfff">
    <name>Francesco P. Carmone</name>
  </developer>

  <url type="homepage">https://github.com/enfff/penna-frontend</url>
  <url type="vcs-browser">https://github.com/enfff/penna-frontend</url>
  <url type="bugtracker">https://github.com/enfff/penna-frontend/issues</url>
  <url type="translate">https://github.com/enfff/penna-frontend/tree/develop/po</url>

  <translation type="gettext">penna-frontend</translation>
  <launchable type="desktop-id">io.github.enfff.Diary.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#f3ede2</color>
    <color type="primary" scheme_preference="dark">#33302b</color>
  </branding>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <releases>
    <release version="0.1.4" date="2026-08-28">
      <description>
        <p>A sync and performance pass:</p>
        <ul>
          <li>Clone a diary repository, with keychain auth for hosted repos</li>
          <li>Conflict resolver gains a "keep both" resolution</li>
          <li>Live finger-tracked forward swipe to the next note</li>
          <li>Save, grid refresh, and watcher reload now run off the main thread</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2026-08-25">
      <description>
        <p>This release focuses on navigation and reach:</p>
        <ul>
          <li>Back-swipe to the notes grid also works over scrollable notes</li>
          <li>Sync moved to a header bar button; repository switching lives in Preferences</li>
          <li>Initial translations: German, French, Italian</li>
          <li>GNOME 50 runtime; refreshed visuals and gesture handling</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
