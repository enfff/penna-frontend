#: data/io.github.enfff.Diary.desktop.in:2
msgid "Diary"
msgstr "Tagebuch"

#: data/io.github.enfff.Diary.desktop.in:3
msgid "Journal"
msgstr "Tagebuch"

#: data/io.github.enfff.Diary.desktop.in:4
msgid "Keep a journal of your thoughts and memories"
msgstr "Führe ein Tagebuch für deine Gedanken und Erinnerungen"

#: data/io.github.enfff.Diary.desktop.in:10
msgid "GTK;Diary;Journal;Notes;"
msgstr "GTK;Tagebuch;Journal;Notizen;"

#: data/io.github.enfff.Diary.metainfo.xml.in:8
msgid "A calm place for daily notes"
msgstr "Ein ruhiger Ort für tägliche Notizen"

#: data/io.github.enfff.Diary.metainfo.xml.in:15
msgid "Highlights:"
msgstr "Funktionen:"

#: data/io.github.enfff.Diary.metainfo.xml.in:17
msgid "Distraction-free editor with optional viewer mode"
msgstr "Ablenkungsfreier Editor mit optionalem Ansichtsmodus"

#: data/io.github.enfff.Diary.metainfo.xml.in:18
msgid "One note per day, found fast in a searchable grid"
msgstr "Eine Notiz pro Tag, schnell im durchsuchbaren Raster gefunden"

#: data/io.github.enfff.Diary.metainfo.xml.in:19
msgid "Markdown formatting with syntax highlighting"
msgstr "Markdown-Formatierung mit Syntaxhervorhebung"

#: data/io.github.enfff.Diary.metainfo.xml.in:20
msgid "History and multi-machine sync through plain git"
msgstr "Verlauf und Synchronisierung zwischen Geräten über plain git"

#: data/io.github.enfff.Diary.metainfo.xml.in:21
msgid "Conflict-safe syncing with a guided resolver"
msgstr "Konfliktsichere Synchronisierung mit geführtem Konfliktlöser"

#: data/io.github.enfff.Diary.metainfo.xml.in:26
msgid "Francesco P. Carmone"
msgstr "Francesco P. Carmone"

#: data/io.github.enfff.Diary.metainfo.xml.in:55
msgid "This release focuses on navigation and reach:"
msgstr "Diese Version verbessert Navigation und Bedienbarkeit:"

#: data/io.github.enfff.Diary.metainfo.xml.in:57
msgid "Back-swipe to the notes grid also works over scrollable notes"
msgstr "Zurückwischen zum Notizenraster funktioniert jetzt auch bei scrollbaren Notizen"

#: data/io.github.enfff.Diary.metainfo.xml.in:59
msgid "Initial translations: German, French, Italian"
msgstr "Erste Übersetzungen: Deutsch, Französisch, Italienisch"

#: data/io.github.enfff.Diary.metainfo.xml.in:60
msgid "GNOME 50 runtime; refreshed visuals and gesture handling"
msgstr "GNOME-50-Laufzeit; überarbeitete Optik und Gestensteuerung"

#: data/io.github.enfff.Diary.gschema.xml:6
msgid "Selected repository path"
msgstr "Ausgewählter Repository-Pfad"

#: data/io.github.enfff.Diary.gschema.xml:7
msgid "Journal repository path selected during setup."
msgstr "Während der Einrichtung gewählter Journal-Repository-Pfad."

#: data/io.github.enfff.Diary.gschema.xml:11
msgid "Enable auto-save"
msgstr "Automatisches Speichern aktivieren"

#: data/io.github.enfff.Diary.gschema.xml:12
msgid "Save the current note automatically when you leave it."
msgstr "Speichert die aktuelle Notiz automatisch, wenn Sie sie verlassen."

#: data/io.github.enfff.Diary.gschema.xml:16
msgid "Open editor in viewer mode"
msgstr "Editor im Ansichtsmodus öffnen"

#: data/io.github.enfff.Diary.gschema.xml:17
msgid "Whether notes should be shown read-only instead of editable."
msgstr "Legt fest, ob Notizen schreibgeschützt statt bearbeitbar angezeigt werden."

#: data/io.github.enfff.Diary.gschema.xml:21
msgid "Editor font preset"
msgstr "Editor-Schriftvoreinstellung"

#: data/io.github.enfff.Diary.gschema.xml:22
msgid "Editor font option: sans, serif, or custom."
msgstr "Editor-Schriftoption: serifenlos, mit Serifen oder benutzerdefiniert."

#: data/io.github.enfff.Diary.gschema.xml:26
msgid "Custom editor font family"
msgstr "Eigene Editor-Schriftfamilie"

#: data/io.github.enfff.Diary.gschema.xml:27
msgid "Custom font family used when editor font preset is custom."
msgstr "Eigene Schriftfamilie, wenn als Editor-Voreinstellung „Benutzerdefiniert“ gewählt ist."

#: data/io.github.enfff.Diary.gschema.xml:31
msgid "Entry date/time display format"
msgstr "Anzeigeformat für Datum/Uhrzeit des Eintrags"

