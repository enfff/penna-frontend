msgid "Selected repository path"
msgstr "Percorso del repository selezionato"

#: data/io.github.enfff.Diary.gschema.xml:7
msgid "Journal repository path selected during setup."
msgstr "Percorso del repository del diario scelto durante la configurazione."

#: data/io.github.enfff.Diary.gschema.xml:11
msgid "Enable auto-save"
msgstr "Attiva il salvataggio automatico"

#: data/io.github.enfff.Diary.gschema.xml:12
msgid "Save the current note automatically when you leave it."
msgstr "Salva automaticamente la nota corrente quando la lasci."

#: data/io.github.enfff.Diary.gschema.xml:16
msgid "Open editor in viewer mode"
msgstr "Apri l’editor in modalità lettura"

#: data/io.github.enfff.Diary.gschema.xml:17
msgid "Whether notes should be shown read-only instead of editable."
msgstr ""
"Indica se le note vengono mostrate in sola lettura invece che modificabili."

#: data/io.github.enfff.Diary.gschema.xml:21
msgid "Editor font preset"
msgstr "Preimpostazione carattere dell’editor"

#: data/io.github.enfff.Diary.gschema.xml:22
msgid "Editor font option: sans, serif, or custom."
msgstr ""
"Opzione carattere dell’editor: senza grazie, con grazie o personalizzato."

#: data/io.github.enfff.Diary.gschema.xml:26
msgid "Custom editor font family"
msgstr "Famiglia di caratteri personalizzata dell’editor"

#: data/io.github.enfff.Diary.gschema.xml:27
msgid "Custom font family used when editor font preset is custom."
msgstr ""
"Famiglia di caratteri usata quando la preimpostazione dell’editor è "
"«Personalizzato»."

#: data/io.github.enfff.Diary.gschema.xml:31
msgid "Entry date/time display format"
msgstr "Formato di visualizzazione data/ora della voce"

#: data/io.github.enfff.Diary.gschema.xml:32
msgid ""
"Chrono strftime format used to render entry IDs, e.g. %Y-%m-%d or %Y-%m-%d "
"%H:%M."
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:8
msgid "A calm place for daily notes"
msgstr "Un luogo tranquillo per le note di ogni giorno"

#: data/io.github.enfff.Diary.metainfo.xml.in:10
msgid ""
"Diary is a local-first journaling app. Every entry is a plain Markdown file "
"stored in a git repository you own — no accounts, no cloud service, no lock-"
"in."
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:15
msgid "Highlights:"
msgstr "Punti salienti:"

#: data/io.github.enfff.Diary.metainfo.xml.in:17
msgid "Distraction-free editor with optional viewer mode"
msgstr "Editor senza distrazioni con modalità lettura facoltativa"

#: data/io.github.enfff.Diary.metainfo.xml.in:18
msgid "One note per day, found fast in a searchable grid"
msgstr "Una nota al giorno, ritrovata in un attimo in una griglia con ricerca"

#: data/io.github.enfff.Diary.metainfo.xml.in:19
msgid "Markdown formatting with syntax highlighting"
msgstr "Formattazione Markdown con evidenziazione della sintassi"

#: data/io.github.enfff.Diary.metainfo.xml.in:20
msgid "History and multi-machine sync through plain git"
msgstr "Cronologia e sincronizzazione tra dispositivi tramite git"

#: data/io.github.enfff.Diary.metainfo.xml.in:21
msgid "Conflict-safe syncing with a guided resolver"
msgstr "Sincronizzazione sicura dai conflitti con risolutore guidato"

#: data/io.github.enfff.Diary.metainfo.xml.in:26
msgid "Francesco P. Carmone"
msgstr "Francesco P. Carmone"

#: data/io.github.enfff.Diary.metainfo.xml.in:55
msgid "A sync and performance pass:"
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:57
msgid "Clone a diary repository, with keychain auth for hosted repos"
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:58
msgid "Conflict resolver gains a \"keep both\" resolution"
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:59
msgid "Live finger-tracked forward swipe to the next note"
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:60
msgid "Save, grid refresh, and watcher reload now run off the main thread"
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:66
msgid "This release focuses on navigation and reach:"
msgstr ""
"Questa versione si concentra su navigazione e accessibilità delle funzioni:"

#: data/io.github.enfff.Diary.metainfo.xml.in:68
msgid "Back-swipe to the notes grid also works over scrollable notes"
msgstr "Lo swipe indietro alla griglia funziona anche con le note lunghe"

#: data/io.github.enfff.Diary.metainfo.xml.in:69
msgid ""
"Sync moved to a header bar button; repository switching lives in Preferences"
msgstr ""

#: data/io.github.enfff.Diary.metainfo.xml.in:70
msgid "Initial translations: German, French, Italian"
msgstr "Prime traduzioni: tedesco, francese, italiano"

#: data/io.github.enfff.Diary.metainfo.xml.in:71
msgid "GNOME 50 runtime; refreshed visuals and gesture handling"
msgstr "Runtime GNOME 50; grafica e gesti rinnovati"

